# =============================================================================
# .env.example — Incluyendo SP API
# Copiá este archivo a .env y completá los valores reales.
# NUNCA commitees .env (está en .gitignore).
# =============================================================================

# Puerto donde escucha el servidor Express
PORT=3000

# Configuración de MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_NAME=incluyendo_sp
# Requerido para hosts remotos que exigen TLS (ej: Aiven).
# Acepta true/1/yes/on (case-insensitive); cualquier otro valor = false.
DB_SSL=false
# Máximo de conexiones simultáneas del pool (default: 5 — Render free 512MB).
# Ráfagas se absorben con la cola finita (queueLimit 50, fijo en db.js).
DB_CONNECTION_LIMIT=5

# Webhook de n8n que recibe el payload del asistente. Contrato:
# { systemPrompt, context: { count, truncated, institutions }, userMessage }
N8N_WEBHOOK_URL=https://tu-instancia.n8n.cloud/webhook/orientar

# Webhook de n8n que recibe las sugerencias de la comunidad y dispara el mail
# de aviso (opcional: si no está, la sugerencia igual se guarda en MySQL)
N8N_SUGGESTIONS_WEBHOOK_URL=https://tu-instancia.n8n.cloud/webhook/sugerencia-mail

# Timeout del fetch al webhook del asistente en ms (default: 20000).
# AbortSignal.timeout cancela el fetch de verdad; excedido → 504.
N8N_TIMEOUT_MS=20000

# Orígenes permitidos por CORS, coma-separada (fuente de verdad).
# Ej: https://app.incluyendosp.com.ar,https://admin.incluyendosp.com.ar
FRONTEND_URLS=http://localhost:5173
# FRONTEND_URL se mantiene como fallback DEPRECATED (si FRONTEND_URLS no está).
# FRONTEND_URL=http://localhost:5173

# Límite de instituciones inyectadas como contexto al asistente (default: 50).
# Técnica LIMIT+1: si hay más, se truncan y se loguea un warning.
CONTEXT_LIMIT=50

# Entorno de ejecución: development | production
NODE_ENV=development