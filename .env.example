# =============================================================================
# .env.example — Incluyendo SP API
# Copiá este archivo a .env y completá los valores reales.
# NUNCA commitees .env (está en .gitignore).
# =============================================================================

# Puerto donde escucha el servidor Express
PORT=3000

# Configuración de MySQL
DB_HOST=localhost
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_NAME=incluyendo_sp

# Webhook de n8n que recibe el prompt enriquecido del asistente
N8N_WEBHOOK_URL=https://tu-instancia.n8n.cloud/webhook/orientar

# Webhook de n8n que recibe las sugerencias de la comunidad y dispara el mail
# de aviso (opcional: si no está, la sugerencia igual se guarda en MySQL)
N8N_SUGGESTIONS_WEBHOOK_URL=https://tu-instancia.n8n.cloud/webhook/sugerencia-mail

# Origen permitido por CORS (URL del frontend deployado)
FRONTEND_URL=http://localhost:5173

# Entorno de ejecución: development | production
NODE_ENV=development